# Copy to .env (git-ignored) and change every value before deploying.
DB_PASSWORD=change-me
# 32+ characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=admin@yourshop.com
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# New-order email alerts (optional). MAIL_PASSWORD is a Gmail app password; OWNER_EMAIL defaults to MAIL_USERNAME.
MAIL_USERNAME=
MAIL_PASSWORD=
OWNER_EMAIL=
