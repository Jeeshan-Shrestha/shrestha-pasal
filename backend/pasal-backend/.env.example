# Copy to .env (git-ignored) and change every value before deploying.
DB_PASSWORD=change-me
# 32+ characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=admin@yourshop.com
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Order emails (optional): placed + cancelled, sent to the customer and OWNER_EMAIL. MAIL_PASSWORD is a Gmail app password; OWNER_EMAIL defaults to MAIL_USERNAME.
MAIL_USERNAME=
MAIL_PASSWORD=
OWNER_EMAIL=

# Hosts that block SMTP (Render free): send order emails through Brevo's HTTPS API instead of Gmail.
# MAIL_FROM must be a sender you verified in Brevo. When BREVO_API_KEY is set it is used instead of Gmail.
BREVO_API_KEY=
MAIL_FROM=
